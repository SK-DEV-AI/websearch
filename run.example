#!/usr/bin/env bash
# Copy to 'run' and fill in your API keys
export NV_KEY="nvapi-YOUR_KEY"
export GROQ_API_KEYS="gsk-YOUR_KEY"
export TAVILY_KEYS="tvly-dev-YOUR_KEY"
export TINYFISH_KEYS="sk-tinyfish-YOUR_KEY"
export ANYSEARCH_KEY="as_sk_YOUR_KEY"
# Free academic keys (optional passthrough; lane workers read env):
# S2_API_KEY at semanticscholar.org/product/api, OPENALEX_API_KEY at openalex.org
# export S2_API_KEY="${S2_API_KEY:-}"
# export OPENALEX_API_KEY="${OPENALEX_API_KEY:-}"

export RERANKER_MODEL="Alibaba-NLP/gte-reranker-modernbert-base"
exec /home/sk/.local/share/venvs/mcp/bin/python3 "$(dirname "$0")/server.py" "$@"
